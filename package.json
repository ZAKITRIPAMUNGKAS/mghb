{
  "name": "laku-transit-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Laku — Perencana Perjalanan Transportasi Umum Jabodetabek",
  "author": "Zaki Tri Pamungkas",
  "scripts": {
    "dev": "pnpm --filter \"@laku/*\" dev",
    "dev:api": "pnpm --filter @laku/api dev",
    "dev:web": "pnpm --filter @laku/web dev",
    "build": "pnpm --filter \"@laku/*\" build",
    "test": "pnpm --filter \"@laku/*\" test",
    "pipeline:run": "pnpm --filter @laku/pipeline run start",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
