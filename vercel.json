{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/beranda", "destination": "/index.html" },
    { "source": "/inventaris", "destination": "/index.html" },
    { "source": "/keuangan", "destination": "/index.html" },
    { "source": "/logbook", "destination": "/index.html" },
    { "source": "/toolkit", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/news",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=120, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
